{
  "name": "patagonia-dashboard",
  "private": true,
  "description": "Mapa interactivo Brasil - Patagonia (GORE Aysén). Static site served by GitHub Pages.",
  "homepage": "https://rarubilar.github.io/patagonia-dashboard/mapa",
  "repository": "github:rarubilar/patagonia-dashboard",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.min.css --minify",
    "vendor": "node scripts/vendor.mjs",
    "build": "npm run vendor && npm run build:css",
    "test": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "chart.js": "4.5.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "leaflet": "1.9.4",
    "tailwindcss": "3.4.19",
    "playwright": "1.56.1"
  }
}
